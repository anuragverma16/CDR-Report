# Local development: leave VITE_API_URL empty. Vite proxies /api to http://localhost:4000.
#   cp .env.example .env.local
#   VITE_API_URL=
#
# Vercel: add this in Project Settings → Environment Variables for Production AND Preview.
# Value: the API's public address from Render, with no trailing slash, e.g.
#   VITE_API_URL=https://tata-dialer-api.onrender.com
# Vite bakes this into the build, so redeploy after changing it.
VITE_API_URL=
