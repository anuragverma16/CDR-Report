# Copy to .env (local) or enter these in Render's environment settings. Never commit real values.

NODE_ENV=development
PORT=4000
# Local: mongodb://127.0.0.1:27017/tata_dialer_reports · Render: a MongoDB Atlas connection string
MONGODB_URI=
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h
# Website addresses, comma-separated, exact match, no trailing slash: the Vercel production URL and any preview URLs
# e.g. https://tata-dialer.vercel.app,http://localhost:5173
CORS_ORIGIN=http://localhost:5173
# Local http: false. Render (https): true
COOKIE_SECURE=false
# lax when the client and API share a domain (localhost). none when they are on different domains (Render);
# none always makes the cookie Secure, so it needs https
COOKIE_SAMESITE=lax
# 1 behind Render's proxy (correct client IPs for rate limiting)
TRUST_PROXY=1
APP_TIMEZONE=Asia/Kolkata

# Storage for uploads and generated reports. Render: a persistent disk path such as /var/data/storage
STORAGE_DIR=./storage
MAX_UPLOAD_MB=25
MAX_FILES_PER_UPLOAD=10
MAX_ROWS_PER_FILE=500000

# MySQL (dialer database)
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_ANSWERED_TABLE=answered_calls
MYSQL_MISSED_TABLE=missed_calls
MYSQL_DISPOSITIONS_TABLE=call_dispositions

# WhatsApp (Nexsahay gateway)
WHATSAPP_PROVIDER=nexsahay
NEXSAHAY_API_BASE=https://whatsappbackend.sengarinfotech.com/api
NEXSAHAY_API_KEY=
NEXSAHAY_SESSION_ID=

# Delivery retries
DELIVERY_MAX_ATTEMPTS=3
DELIVERY_RETRY_DELAY_MINUTES=10

# Optional: AI wording for team motivation messages. Without it, predefined messages are used.
ANTHROPIC_API_KEY=
